{
  "prores422hq": {
    "description": "Apple ProRes 422 HQ, 10-bit 4:2:2, PCM audio",
    "ext": "mov",
    "pixFmt": "yuv422p10le",
    "video": ["-c:v", "prores_ks", "-profile:v", "3", "-vendor", "apl0"],
    "audio": ["-c:a", "pcm_s16le"]
  },
  "prores422": {
    "description": "Apple ProRes 422, 10-bit 4:2:2, PCM audio",
    "ext": "mov",
    "pixFmt": "yuv422p10le",
    "video": ["-c:v", "prores_ks", "-profile:v", "2", "-vendor", "apl0"],
    "audio": ["-c:a", "pcm_s16le"]
  },
  "prores4444": {
    "description": "Apple ProRes 4444, 10-bit 4:4:4, PCM audio",
    "ext": "mov",
    "pixFmt": "yuv444p10le",
    "video": ["-c:v", "prores_ks", "-profile:v", "4", "-vendor", "apl0"],
    "audio": ["-c:a", "pcm_s16le"]
  },
  "h264": {
    "description": "H.264 high quality (CRF 16), 8-bit 4:2:0, AAC 320k",
    "ext": "mp4",
    "pixFmt": "yuv420p",
    "video": ["-c:v", "libx264", "-preset", "slow", "-crf", "16"],
    "audio": ["-c:a", "aac", "-b:a", "320k"],
    "extra": ["-movflags", "+faststart"]
  },
  "h265_10bit": {
    "description": "H.265 / HEVC (CRF 18), 10-bit 4:2:0, AAC 320k",
    "ext": "mp4",
    "pixFmt": "yuv420p10le",
    "video": ["-c:v", "libx265", "-preset", "medium", "-crf", "18", "-tag:v", "hvc1"],
    "audio": ["-c:a", "aac", "-b:a", "320k"],
    "extra": ["-movflags", "+faststart"]
  },
  "h265_preview": {
    "description": "H.265 VBR 7 Mbps full res, 8-bit 4:2:0 Main, AAC 320k (matches Premiere h265_4k_preview; small files for Magnific etc.)",
    "ext": "mp4",
    "pixFmt": "yuv420p",
    "video": ["-c:v", "libx265", "-preset", "medium", "-profile:v", "main", "-b:v", "7M", "-maxrate", "10500k", "-bufsize", "14M", "-x265-params", "log-level=error", "-tag:v", "hvc1"],
    "audio": ["-c:a", "aac", "-b:a", "320k", "-ar", "48000", "-ac", "2"],
    "extra": ["-movflags", "+faststart"]
  },
  "h265_preview_nvenc": {
    "description": "As h265_preview, on the NVIDIA GPU (needs a driver new enough for this FFmpeg's NVENC)",
    "ext": "mp4",
    "pixFmt": "yuv420p",
    "video": ["-c:v", "hevc_nvenc", "-preset", "p7", "-tune", "hq", "-profile:v", "main", "-tier", "main", "-rc", "vbr", "-multipass", "disabled", "-b:v", "7M", "-maxrate", "10500k", "-bufsize", "14M", "-tag:v", "hvc1"],
    "audio": ["-c:a", "aac", "-b:a", "320k", "-ar", "48000", "-ac", "2"],
    "extra": ["-movflags", "+faststart"]
  }
}
